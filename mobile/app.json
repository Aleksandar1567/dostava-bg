{
  "expo": {
    "name": "Dostava BG",
    "slug": "dostava-bg",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Kamera se koristi za skeniranje QR etiketa paketa.",
        "NSLocationWhenInUseUsageDescription": "Lokacija se koristi za računanje vremena dolaska do kupaca."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Kamera se koristi za skeniranje QR etiketa paketa."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Lokacija se koristi za računanje vremena dolaska do kupaca."
        }
      ]
    ]
  }
}
